{
  "manifest_version": 3,
  "name": "Show IMDb Ratings on Streaming Services",
  "version": "1.0.0",
  "description": "Shows IMDb ratings on title cards on Netflix, Prime Video, Hulu, HBO Max, Apple TV, Disney+, Paramount+ and Tubi.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "unlimitedStorage", "alarms", "offscreen"],
  "host_permissions": ["https://www.omdbapi.com/", "https://datasets.imdbws.com/"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["sites/netflix.js", "content.js"],
      "css": ["badge.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.amazon.com/gp/video/*", "https://www.primevideo.com/*"],
      "js": ["sites/primevideo.js", "content.js"],
      "css": ["badge.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.hulu.com/*"],
      "js": ["sites/hulu.js", "content.js"],
      "css": ["badge.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://play.hbomax.com/*"],
      "js": ["sites/hbomax.js", "content.js"],
      "css": ["badge.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://tv.apple.com/*"],
      "js": ["sites/appletv.js", "content.js"],
      "css": ["badge.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.disneyplus.com/*"],
      "js": ["sites/disneyplus.js", "content.js"],
      "css": ["badge.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://tubitv.com/*"],
      "js": ["sites/tubi.js", "content.js"],
      "css": ["badge.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.paramountplus.com/*"],
      "js": ["sites/paramountplus.js", "content.js"],
      "css": ["badge.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "IMDb Ratings: settings"
  }
}
